# Copy to .env. Every variable is optional for local development — the app runs with zero keys (PLAYBOOK §9.4).

# Public base URL used in invite / reset links.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Secret for sessions and signed file URLs. REQUIRED in production; dev uses an insecure default.
BETTER_AUTH_SECRET=

# Database. Unset = embedded Postgres (PGlite) stored in PGLITE_DIR. Set = real Postgres.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Uploaded files (local disk fallback for object storage).
UPLOAD_DIR=.data/uploads

# Google sign-in. Leave empty and the Google button stays hidden. Founder creates the OAuth app (docs/RUNBOOK.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password for the fictional demo users created by `pnpm seed` (local only).
DEMO_PASSWORD=campusly-demo-1
