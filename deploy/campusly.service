[Unit]
Description=Campusly web app
Requires=campusly-configure.service
After=campusly-configure.service

[Service]
User=campusly
WorkingDirectory=/opt/campusly
EnvironmentFile=/etc/campusly/env
# Listens only on the server itself; visitors come in through Caddy (HTTPS).
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
